CGF_SCHEME=https
CGF_HOST=firewall.example.com
CGF_PORT=8443
CGF_TOKEN=replace-with-api-token
CGF_CERT_NAME=letsencrypt-certificate
CGF_COMMENT="Imported by certificate sync script"
CGF_INSECURE=0
# CGF_CACERT=/path/to/your/trusted-ca.pem
LIVE_DIR=/path/to/nginx-proxy-manager/letsencrypt/live/certificate-directory
ROOT_CA_DIR=/root/cgf-roots
# Optional: enable service verification only after checking service paths.
# CGF_VERIFY="vpn.example.com:443=service-container/VPN"