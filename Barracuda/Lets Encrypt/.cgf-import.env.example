# Protokół używany do połączenia z REST API CGF; zalecane HTTPS.
CGF_SCHEME=https
# Adres IP lub nazwa hosta Barracuda CloudGen Firewall.
CGF_HOST=firewall.example.com
# Port REST API CGF; typowo 8443 dla HTTPS.
CGF_PORT=8443
# Token REST API CGF wysyłany w nagłówku X-API-Token. Nie udostępniaj prawdziwego tokenu.
CGF_TOKEN=replace-with-api-token
# Nazwa certyfikatu, pod którą będzie zapisany w magazynie CGF.
CGF_CERT_NAME=letsencrypt-certificate
# Komentarz/opis przypisany do wpisu certyfikatu w CGF.
CGF_COMMENT="Imported by certificate sync script"
# 1 wyłącza weryfikację certyfikatu TLS serwera CGF; pozostaw 0, jeśli to możliwe.
CGF_INSECURE=0
# Opcjonalna ścieżka do CA zaufanego dla HTTPS, używana gdy CGF_INSECURE=0.
# CGF_CACERT=/path/to/your/trusted-ca.pem
# Katalog Nginx Proxy Manager zawierający aktualne fullchain.pem i privkey.pem.
# NPM odnawia certyfikat; dla tej integracji wybierz certyfikat RSA.
LIVE_DIR=/path/to/nginx-proxy-manager/letsencrypt/live/certificate-directory
# Katalog z zaufanymi, samopodpisanymi certyfikatami root CA do uzupełnienia łańcucha.
ROOT_CA_DIR=/root/cgf-roots
# Opcjonalna lista usług do sprawdzenia po imporcie, rozdzielona spacjami.
# Format: host:port=ścieżka-usługi. Port można pominąć dla HTTPS/443.
# Skrypt może restartować usługę, jeśli nadal prezentuje inny certyfikat.
# CGF_VERIFY="vpn.example.com:443=service-container/VPN"